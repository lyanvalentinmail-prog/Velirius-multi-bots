# ─────────────────────────────────────────────────────────────
# Velirius Multi-Bots · variables de entorno del servidor
# Copia este archivo a ".env" y ajusta los valores.
# El panel es de acceso directo: no requiere login ni token.
# ─────────────────────────────────────────────────────────────

# Puerto HTTP (Render lo inyecta automáticamente)
PORT=3000

# URL base de la API de Velirius (sin barra final)
VELIRIUS_API=https://velirius-api-sd8u.vercel.app

# Nombre visible en el panel
APP_NAME=Velirius Multi-Bots
