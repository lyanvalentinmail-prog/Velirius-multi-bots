# ─────────────────────────────────────────────────────────────
# Velirius Multi-Bots · variables de entorno del servidor
# Copia este archivo a ".env" y ajusta los valores.
# En Render/Vercel se declaran en la pestaña Environment.
# ─────────────────────────────────────────────────────────────

# Puerto HTTP (Render lo inyecta automáticamente)
PORT=3000

# Secreto para firmar los tokens de sesión. Si lo dejas vacío se
# genera uno persistente en server/data/.jwt-secret.
AUTH_SECRET=

# Vencimiento de los tokens de sesión en días
TOKEN_TTL_DAYS=30

# Token de servicio OPCIONAL. Si lo defines, además del login de
# usuarios se acepta este valor como Bearer para integraciones/API.
DASHBOARD_TOKEN=

# Google Sign-In (Google Identity Services, ID token).
# Crea un cliente OAuth 2.0 "Web application" en Google Cloud Console
# y añade aquí su Client ID. Vacío = botón de Google desactivado.
GOOGLE_CLIENT_ID=

# URL base de la API de Velirius (sin barra final)
VELIRIUS_API=https://velirius-api-sd8u.vercel.app

# Nombre visible en el panel
APP_NAME=Velirius Multi-Bots
